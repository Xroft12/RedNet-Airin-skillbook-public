{
  "name": "rednet-airin-meta-skills",
  "version": "0.2.2",
  "date": "2026-06-08",
  "language": "ru",
  "description": "Установочный пакет REDNET Airin Skillbook: мета-навыки, протоколы сопровождения, observe-only сенсоры и Stage 1 advise нейро-узла сервисов.",
  "default_mode": "dry-run",
  "live_runtime_policy": "do-not-touch-live-hermes-without-maintenance-window",
  "includes": {
    "skill_roots": [
      "skills/rednet",
      "skills/rednet-meta"
    ],
    "protocols": [
      "protocols/session-guided-activation.md",
      "protocols/manifest-change-support.md",
      "protocols/skill-awakening-dialogue.md",
      "protocols/acceptance-and-disable.md"
    ],
    "sensor_prototype": "sensor-prototype/airin-signal-sensor",
    "wakefulness_prototype": "sensor-prototype/airin-wakefulness-node",
    "neural_service_node_prototype": "sensor-prototype/airin-neural-service-node",
    "installer": "packages/hermes/rednet-airin-meta-skills/install.ps1"
  },
  "skills": [
    {"name": "rednet-double-evaluation", "path": "skills/rednet/rednet-double-evaluation", "layer": "mvp-plus", "version": "1.4.0", "modes": ["off", "observe", "light", "full", "manifest", "hold", "short-term", "signal", "passive", "service", "feel"]},
