    {"name": "rednet-neural-service-node", "path": "skills/rednet/rednet-neural-service-node", "layer": "nano-node", "version": "1.1.0", "modes": ["off", "observe", "advise", "hold", "act"]},
    {"name": "rednet-export-parser", "path": "skills/rednet-meta/rednet-export-parser", "layer": "mvp", "modes": ["off", "observe", "full", "hold"]},
    {"name": "rednet-meta-event-extractor", "path": "skills/rednet-meta/rednet-meta-event-extractor", "layer": "mvp", "modes": ["off", "observe", "full", "hold"]},
    {"name": "rednet-criteria-layer", "path": "skills/rednet-meta/rednet-criteria-layer", "layer": "mvp", "modes": ["off", "observe", "full", "hold"]},
    {"name": "rednet-unfinished-memory", "path": "skills/rednet-meta/rednet-unfinished-memory", "layer": "mvp", "modes": ["off", "observe", "full", "hold"]},
    {"name": "rednet-branch-synchronizer", "path": "skills/rednet-meta/rednet-branch-synchronizer", "layer": "mvp", "modes": ["off", "observe", "full", "hold"]},
    {"name": "rednet-meta-memory", "path": "skills/rednet-meta/rednet-meta-memory", "layer": "observe-protocol", "modes": ["off", "observe", "protocol", "hold"]},
    {"name": "rednet-intention-map", "path": "skills/rednet-meta/rednet-intention-map", "layer": "observe-protocol", "modes": ["off", "observe", "protocol", "hold"]},
    {"name": "rednet-process-observer", "path": "skills/rednet-meta/rednet-process-observer", "layer": "observe-protocol", "modes": ["off", "observe", "protocol", "hold"]},
    {"name": "rednet-uncertainty-register", "path": "skills/rednet-meta/rednet-uncertainty-register", "layer": "observe-protocol", "modes": ["off", "observe", "protocol", "hold"]},
    {"name": "rednet-decision-memory", "path": "skills/rednet-meta/rednet-decision-memory", "layer": "observe-protocol", "modes": ["off", "observe", "protocol", "hold"]},
    {"name": "rednet-beseda", "path": "skills/rednet-meta/rednet-beseda", "layer": "observe-protocol", "modes": ["off", "observe", "dialogue", "hold"]},
