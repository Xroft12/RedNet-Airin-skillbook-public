# Copy to a private .env outside public reports.
REDNET_AGENT_MODE=observe
REDNET_MODEL_BASE_URL=http://model-proxy.example.local/api
REDNET_MODEL_AUTH_REF=stored-outside-repo
REDNET_MODEL_NAME=qwen-plus-or-best-available
REDNET_MEMORY_NAMESPACE=rednet:science-coordinator
REDNET_PORTAL_LABEL=Научный координатор
REDNET_LIVE_COMMANDS=false
REDNET_SECRET_LOGGING=false
REDNET_ALLOWED_FLOWS=papers,concepts,skills,services,subagents,publication,incidents
REDNET_REQUIRED_ARTIFACT=true
