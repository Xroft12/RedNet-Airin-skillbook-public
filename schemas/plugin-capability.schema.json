{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rednet.local/schemas/plugin-capability.schema.json",
  "title": "REDNET Plugin Capability Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["map_id", "plugins"],
  "properties": {
    "map_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capabilities",
          "allowed_modes",
          "risk",
          "enabled",
          "operator_window_required"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["read", "write", "network", "publish", "identity", "shell"]
            },
            "uniqueItems": true
          },
          "allowed_modes": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "enabled": { "type": "boolean", "const": false },
          "operator_window_required": { "type": "boolean" }
        }
      }
    }
  }
}
